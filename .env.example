# Copiar a .env en la raíz del proyecto o en backend/.env

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=20

CIVUCE_BASE_URL=https://qa.ci.vuce.gob.ar
CIVUCE_AUTH_EMAIL=vuce@vuce.gob.ar
CIVUCE_MAX_RESULTADOS=12
CIVUCE_TIMEOUT_SECONDS=20

SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
HISTORIAL_PATH=data/selecciones.jsonl
HISTORIAL_UMBRAL=0.82
